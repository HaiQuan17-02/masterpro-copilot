# MASTERPRO COPILOT CONFIGURATION TEMPLATE
# Sao chép file này thành .env hoặc .env.production và cập nhật các giá trị thực tế

# Môi trường ứng dụng (development | testing | production)
APP_ENV=production
LOG_LEVEL=INFO

# Cấu hình bảo mật JWT
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Cấu hình AI Provider (Online & Offline)
# Các chế độ hỗ trợ: auto | online_preferred | offline_only
AI_PROVIDER_MODE=auto

# Khóa API mô hình AI trực tuyến (Tùy chọn: để trống nếu muốn chạy Offline hoàn toàn)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Cấu hình Qdrant Vector Store
# Để trống QDRANT_URL để sử dụng lưu trữ tệp cục bộ (Local Storage Mode tại ai/qdrant_storage)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=masterpro_knowledge_base

# Cấu hình Database MasterPro ERP (SQL Server)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=MasterPro_ERP
DB_USER=sa
DB_PASSWORD=YourPasswordHere
DB_DRIVER=ODBC Driver 17 for SQL Server
